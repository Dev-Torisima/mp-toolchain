<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mpler</AssemblyName>
    <AssemblyTitle>mpler</AssemblyTitle>
    <RootNamespace>mpler</RootNamespace>
    <Configurations>Debug;Release;AOT</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
	  <Copyright>Copyright (c) Torisima</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../reporter-core/project.csproj" />
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'AOT'">
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

</Project>
