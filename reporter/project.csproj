<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>mprpr</AssemblyTitle>
    <AssemblyName>mprpr</AssemblyName>
    <Configurations>Debug;Release;AOT</Configurations>
    <Platforms>AnyCPU;x64;ARM64;x86;ARM32</Platforms>
    <Copyright>Copyright (c) Torisima</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../reporter-core/project.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>LICENSE</TargetPath>
    </None>
    <None Include="../.github/workflows/release-reporter-ThirdPartyNotices.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>ThirdPartyNotices.txt</TargetPath>
    </None>
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'AOT'">
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

</Project>
